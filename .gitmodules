[submodule "panda"]
  path = panda
  url = ../../commaai/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  # spawahh/opendbc, not commaai/opendbc: the Subaru stop-and-go feature needs forked
  # panda safety and car code.
  #
  # Absolute, unlike every other submodule here. The relative form resolves against
  # whatever `origin` happens to be, and this fork gets cloned from more than one
  # place -- the WSL test clone's origin is commaai/openpilot, where `../opendbc.git`
  # would silently fetch commaai's opendbc and the feature would vanish with no error.
  # We want one specific opendbc regardless of where the superproject came from.
  url = https://github.com/spawahh/opendbc.git
[submodule "msgq"]
  path = msgq_repo
  url = ../../commaai/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = ../../commaai/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = ../../commaai/teleoprtc
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/tinygrad/tinygrad.git
